# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=
GOOGLE_API_KEY=
# `auto` chooses OpenAI when both keys are set; set `gemini` or `openai` to force one.
LABEL_QA_LLM_PROVIDER=auto
# Used only for the OpenAI Label QA provider.
MODEL_NAME=gpt-4o-mini
# Used only for the Gemini Label QA provider.
GOOGLE_MODEL_NAME=gemini-flash-latest
# Shared by the OpenAI and Gemini providers.
LLM_TEMPERATURE=0.7

# ---- Optional Label QA Agent ----
# Local execution can still run the detector in-process when agent-yolo is
# installed. Production should use INFERENCE_MODE=remote so the App Service
# calls the standalone GPU service instead of loading Torch/Ultralytics.
INFERENCE_MODE=local
# INFERENCE_SERVICE_URL=https://<cloud-run-inference-url>
# INFERENCE_SERVICE_TOKEN=<shared-app-to-inference-secret>
# INFERENCE_REQUEST_TIMEOUT_SECONDS=30
# YOLO_MODEL_NAME=yolo26n.pt
# YOLO_CONFIDENCE_THRESHOLD=0.25
# AGENT_EVALUATION_CACHE_ENTRIES=128

# ---- Standalone Inference Service ----
# These variables are read by `uvicorn src.inference_app:app`. Use the same
# secret value as INFERENCE_SERVICE_TOKEN in the App Service.
# INFERENCE_AUTH_TOKEN=<shared-app-to-inference-secret>
# INFERENCE_MODEL_NAME=gs://<GCS_BUCKET_NAME>/models/yolo26x.pt
# INFERENCE_MODEL_VERSION=yolo26x@2026-08-27
# INFERENCE_MODEL_CACHE_DIR=/tmp/label-guardian-models
# INFERENCE_MAX_BATCH_SIZE=64
# INFERENCE_CONFIDENCE_THRESHOLD=0.25
# INFERENCE_ALLOWED_OBJECT_PREFIXES=datasets/official

# ---- Real-data MVP / cloud demo ----
# DATASET_BACKEND=database loads normalized metadata from Supabase and streams
# private GCS objects through the backend /content endpoint. DATASET_ROOT is only
# used when DATASET_BACKEND=filesystem.
DATASET_ROOT=data/cloud-db-placeholder
DOCKER_DATASET_ROOT=/app/data/cloud-db-placeholder
DATASET_BACKEND=database
DATASET_ID=product
DATASET_VERSION=<DATASET_VERSION>
DATASET_DEFAULT_SPLIT=smoke

# ---- Supabase PostgreSQL (shared team backend) ----
# Copy the exact host/user from Supabase Dashboard > Connect. Use the Session
# pooler on port 5432 for developer machines that need IPv4.
COMPOSE_PROJECT_NAME=label_guardian
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=label_guardian
POSTGRES_USER=label_guardian
POSTGRES_PASSWORD=label_guardian_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?ssl=require
# Keep this below the Supabase session pooler max; raise only after upgrading DB/pool limits.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0

# Disposable PostgreSQL service used by pytest and the destructive migration lifecycle check.
POSTGRES_TEST_BIND_ADDRESS=127.0.0.1
POSTGRES_TEST_PORT=5433
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5433/label_guardian_test

# Shared Supabase alternative. Copy the exact host/user from Dashboard > Connect,
# percent-encode special characters in the password, and do not use port 6543.
# Session pooler (recommended for developer networks that only support IPv4):
# DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?ssl=require
# Direct connection (IPv6 unless the project has the IPv4 add-on):
# DATABASE_URL=postgresql+asyncpg://postgres:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?ssl=require

# ---- Ingestion worker: GCS + Supabase PostgreSQL ----
# This synchronous URL is consumed by the ingestion worker, not the FastAPI app.
LABEL_GUARDIAN_DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL_ENCODED_PASSWORD>@<SESSION_POOLER_HOST>:5432/postgres?sslmode=require
# Direct connection is also supported if the machine/network supports it:
# LABEL_GUARDIAN_DATABASE_URL=postgresql+psycopg://postgres:<URL_ENCODED_PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres?sslmode=require
LABEL_GUARDIAN_STORAGE_BACKEND=gcs
LABEL_GUARDIAN_GCS_BUCKET=<GCS_BUCKET_NAME>
LABEL_GUARDIAN_GCS_PROJECT=<GCP_PROJECT_ID>
# Prefer CLI Application Default Credentials for local dev:
#   gcloud auth application-default login
# Use a service account JSON only for CI/private runners when needed.
# LABEL_GUARDIAN_GCS_CREDENTIALS_PATH=data/secrets/gcp-service-account.json
# Railway: store the complete service-account JSON as a sealed secret. Do not
# prefix this value with VITE_ and do not commit the real JSON.
# LABEL_GUARDIAN_GCS_CREDENTIALS_JSON={"type":"service_account",...}
LABEL_GUARDIAN_GCS_PUBLIC_URL=https://storage.googleapis.com/<GCS_BUCKET_NAME>
LABEL_GUARDIAN_OBJECT_KEY_PREFIX=datasets/official/<DATASET_NAME>/<DATASET_RELEASE>/<SPLIT>

# ---- Vector Store ----
# Reserved configuration; no Chroma or Pinecone runtime is wired into the app yet.
CHROMA_PERSIST_DIR=./data/chroma

# ---- App Config ----
APP_NAME=Label Guardian API
APP_DESCRIPTION=QA orchestration API for 2D perception annotations
APP_VERSION=0.1.0
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
BACKEND_BIND_ADDRESS=127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ---- Authentication & application RBAC ----
# Supabase Auth stores credentials/sessions. The API verifies its access token;
# application roles are stored in public.application_users.
AUTH_ENABLED=false
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Leave empty for projects using asymmetric signing keys (recommended). The API
# reads the public JWKS endpoint automatically. Set only for a legacy HS256 project.
SUPABASE_JWT_SECRET=
# Backend-only key used for admin invite/disable operations. Never expose in Vite.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated recovery administrators. A listed existing profile is only
# promoted when no Admin remains, so an explicit demotion stays effective.
AUTH_BOOTSTRAP_ADMIN_EMAILS=admin@example.com

# ---- LangSmith (optional tracing) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai20k-agent
# Change to true only after setting a valid LANGCHAIN_API_KEY.
LANGCHAIN_TRACING_V2=false

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (Vite, configured separately) ----
# Copy frontend/.env.example to frontend/.env.local. Vite uses
# VITE_DATA_SOURCE, VITE_API_BASE_URL and the Supabase client variables.
